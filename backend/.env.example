OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Local project database (used when NFNIT_DATABASE_URL is absent)
# NFNIT_DATABASE_PATH=/absolute/path/to/nfinit.db

# Production project database and Supabase JWT verification
# Use the direct or transaction-pooler Postgres connection string from Supabase.
# Railway is detected automatically; set NFNIT_ENV=production elsewhere.
# NFNIT_ENV=production
# NFNIT_DATABASE_URL=postgresql://postgres.project-ref:password@host:6543/postgres
# SUPABASE_URL=https://your-project.supabase.co
# Only required for Supabase projects that still issue legacy HS256 tokens.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# Explicitly permits the shared local identity outside normal development.
# Never enable this on a public deployment.
# NFNIT_ALLOW_LOCAL_AUTH_BYPASS=true

# Optional LangFuse tracing (disabled when keys are absent)
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key
# LANGFUSE_SECRET_KEY=sk-lf-your-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development
# LANGFUSE_RELEASE=git-sha-or-version

# Optional build123d pattern RAG. Without these values, the bundled local
# corpus is searched deterministically. Create an integrated-embedding index
# whose text field maps to "chunk_text".
# PINECONE_API_KEY=pcsk-your-key
# PINECONE_INDEX_HOST=your-index-host.pinecone.io
# PINECONE_INDEX_NAME=nfinit-build123d
# PINECONE_NAMESPACE=build123d-patterns-v1
# PATTERN_RAG_ENABLED=true
# PATTERN_RAG_TOP_K=4
# PATTERN_RAG_MAX_CHARS=6000
# PATTERN_RAG_SNIPPET_MAX_CHARS=1200
# PATTERN_RAG_LOCAL_CORPUS=/absolute/path/to/patterns.json

# Optional: Override CORS allowed origins (comma-separated)
# Defaults to http://localhost:3000 if not set
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional sandbox limits
# CAD_SANDBOX_TIMEOUT_SECONDS=20
# CAD_SANDBOX_CPU_SECONDS=10
# CAD_SANDBOX_MEMORY_BYTES=2147483648
# CAD_SANDBOX_FILE_BYTES=268435456
