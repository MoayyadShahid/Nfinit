# Optional API models (OpenRouter). Local Claude Code / Codex uses your own login.
# Start the free local workspace with `npm run local` from the repository root.
# The launcher creates the private local-agent token; do not put it in this file.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Durable project database (defaults to backend/data/nfinit.db)
# NFNIT_DATABASE_PATH=/absolute/path/to/nfinit.db

# Signs mesh and progress links. Unset: a per-process key (fine for local use).
# NFNIT_MESH_URL_SECRET=
# The API serves only the local single-user workspace. npm run local sets this.
NFNIT_ALLOW_LOCAL_AUTH_BYPASS=true

# Optional local CAD pattern search. Uses the bundled corpus, without an
# embeddings API or vector database.
# PATTERN_RAG_ENABLED=true
# PATTERN_RAG_TOP_K=4
# PATTERN_RAG_MAX_CHARS=6000
# PATTERN_RAG_SNIPPET_MAX_CHARS=1200
# PATTERN_RAG_LOCAL_CORPUS=/absolute/path/to/patterns.json

# Optional: Override CORS allowed origins (comma-separated)
# Defaults to http://localhost:3000 if not set.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional agent run limits: the whole run, and each model call within it
# CAD_RUN_TIMEOUT_SECONDS=300
# A local Claude Code or Codex run, which does more checking in one session
# CAD_LOCAL_RUN_TIMEOUT_SECONDS=900
# CAD_LLM_TIMEOUT_SECONDS=120
# Request bodies are capped while streaming in both frontend and backend.
# CAD_MAX_REQUEST_BYTES=20971520
# Caps on saved content and row counts.
# CAD_MAX_STORAGE_BYTES_PER_USER=134217728
# CAD_MAX_PROJECTS_PER_USER=100
# CAD_MAX_REVISIONS_PER_USER=1000

# Optional sandbox limits
# "fork" (default on Linux) imports OpenCASCADE once and forks a fresh child
# per job. "spawn" (default elsewhere) starts a new worker per job, which
# cold-imports OpenCASCADE every time; 20s is too short on a laptop.
# CAD_SANDBOX_MODE=fork
# CAD_SANDBOX_MAX_CONCURRENCY=4
# CAD_SANDBOX_MAX_CONCURRENT_PER_USER=2
# CAD_SANDBOX_LEASE_SECONDS=240
# CAD_MAX_EVENT_STREAMS_PER_USER=4
# CAD_SANDBOX_TIMEOUT_SECONDS=90
# CAD_SANDBOX_CPU_SECONDS=45
# CAD_SANDBOX_MEMORY_BYTES=2147483648
# CAD_SANDBOX_FILE_BYTES=268435456
# CAD_SANDBOX_MAX_PROCESSES=256
# Root-launched jobs add their pid to these bases for a unique uid/gid.
# CAD_SANDBOX_UID_BASE=100000
# CAD_SANDBOX_GID_BASE=100000
