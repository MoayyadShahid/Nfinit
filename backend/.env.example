# Optional hosted API fallback. Local Claude Code / Codex uses your own login.
# Start the free local workspace with `npm run local` from the repository root.
# The launcher creates the private local-agent token; do not put it in this file.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Durable project database (defaults to backend/data/nfinit.db)
# NFNIT_DATABASE_PATH=/absolute/path/to/nfinit.db

# Production Postgres (PR #22). Leave unset to keep SQLite locally.
# NFNIT_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=only-for-legacy-hs256-projects
# Signs mesh download links. Unset: a per-process key (fine for local use).
# NFNIT_MESH_URL_SECRET=  # production: distinct random value, at least 32 bytes
# Required for local SQLite until production Postgres + Supabase are set.
NFNIT_ALLOW_LOCAL_AUTH_BYPASS=true

# Optional Stripe billing. Unset = everyone can generate and export.
# Forward webhooks locally with:
#   stripe listen --forward-to localhost:8000/billing/webhook
# STRIPE_SECRET_KEY=sk_test_your-key
# STRIPE_WEBHOOK_SECRET=whsec_from-stripe-listen
# STRIPE_PRICE_ID=price_your-monthly-price
# APP_URL=http://localhost:3000

# Optional LangFuse tracing (disabled when keys are absent)
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key
# LANGFUSE_SECRET_KEY=sk-lf-your-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development
# LANGFUSE_RELEASE=git-sha-or-version

# Optional build123d pattern RAG. Without these values, the bundled local
# corpus is searched deterministically. Create an integrated-embedding index
# whose text field maps to "chunk_text".
# PINECONE_API_KEY=pcsk-your-key
# PINECONE_INDEX_HOST=your-index-host.pinecone.io
# PINECONE_INDEX_NAME=nfinit-build123d
# PINECONE_NAMESPACE=build123d-patterns-v1
# PATTERN_RAG_ENABLED=true
# PATTERN_RAG_TOP_K=4
# PATTERN_RAG_MAX_CHARS=6000
# PATTERN_RAG_SNIPPET_MAX_CHARS=1200
# PATTERN_RAG_LOCAL_CORPUS=/absolute/path/to/patterns.json

# Optional: Override CORS allowed origins (comma-separated)
# Defaults to http://localhost:3000 if not set. On Railway include the Vercel URL.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Optional agent run limits: the whole run, and each model call within it
# CAD_RUN_TIMEOUT_SECONDS=300
# CAD_LLM_TIMEOUT_SECONDS=120
# Request bodies are capped while streaming in both frontend and backend.
# CAD_MAX_REQUEST_BYTES=20971520
# Persisted content and row-count caps per account.
# CAD_MAX_STORAGE_BYTES_PER_USER=134217728
# CAD_MAX_PROJECTS_PER_USER=100
# CAD_MAX_REVISIONS_PER_USER=1000

# Optional sandbox limits
# "fork" (default on Linux) imports OpenCASCADE once and forks a fresh child
# per job. "spawn" (default elsewhere) starts a new worker per job, which
# cold-imports OpenCASCADE every time; 20s is too short on a laptop.
# CAD_SANDBOX_MODE=fork
# CAD_SANDBOX_MAX_CONCURRENCY=4
# CAD_SANDBOX_MAX_CONCURRENT_PER_USER=2
# CAD_SANDBOX_LEASE_SECONDS=240
# CAD_MAX_EVENT_STREAMS_PER_USER=4
# CAD_SANDBOX_TIMEOUT_SECONDS=90
# CAD_SANDBOX_CPU_SECONDS=45
# CAD_SANDBOX_MEMORY_BYTES=2147483648
# CAD_SANDBOX_FILE_BYTES=268435456
# CAD_SANDBOX_MAX_PROCESSES=256
# Root-launched jobs add their pid to these bases for a unique uid/gid.
# CAD_SANDBOX_UID_BASE=100000
# CAD_SANDBOX_GID_BASE=100000
