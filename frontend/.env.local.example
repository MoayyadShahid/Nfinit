NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Production: set both to the public Railway API URL.
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app
# BACKEND_URL=https://your-backend.up.railway.app

# Optional Supabase OAuth. When either value is absent, authentication is
# bypassed and /login passes directly through to /studio.
# Create a Supabase project, enable Google, then add:
#   http://localhost:3000/auth/callback
#   https://your-app.vercel.app/auth/callback
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Local Next proxy allows unauthenticated /api/projects. Production
# refuses those calls unless this is set (or Supabase is configured).
NFNIT_ALLOW_LOCAL_AUTH_BYPASS=true
