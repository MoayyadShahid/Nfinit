# Railway = FastAPI CAD backend only. Delete the "frontend" service
# if Railway auto-created one from the repo-root package.json.
#
# On the canvas that only shows "frontend":
#   1. Click that service → Settings → Danger → Delete
#      (the website belongs on Vercel)
#   2. New → GitHub Repo → MoayyadShahid/Nfinit
#   3. Settings → Source → Root Directory: backend
#   4. Settings → Build → Builder: Dockerfile
#      Dockerfile path: Dockerfile
#   5. Settings → Networking → Generate Domain
#   6. Paste the vars below. Then copy the public URL into Vercel
#      as BACKEND_URL and NEXT_PUBLIC_BACKEND_URL.
#
# If you keep one service and just convert it:
#   Settings → Name: backend
#   Root Directory: backend
#   Builder: Dockerfile

OPENROUTER_API_KEY=sk-or-v1-your-key-here
CORS_ORIGINS=https://nfinit.dev,https://www.nfinit.dev,https://your-app.vercel.app

# Projects, revisions and CAD runs live in Supabase Postgres. The container's
# disk is wiped on every deploy, so never run production on SQLite.
#   1. supabase db push   (applies supabase/migrations)
#   2. Create the backend's own login role. It can only SET ROLE into the
#      RLS-restricted nfinit_backend role, never act as postgres:
#        create role nfinit_api login noinherit password '<generated>';
#        grant nfinit_backend to nfinit_api;
#   3. Connect through the session pooler (Railway has no IPv6 egress, and
#      db.PROJECT.supabase.co is IPv6-only):
NFNIT_DATABASE_URL=postgresql://nfinit_api.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# The backend keeps a pool of database connections (default 1 to 10 per
# replica). The session pooler limits clients per project (15 on Supabase's
# smallest plans), so keep NFNIT_DB_POOL_MAX x replicas under that limit.
# Put this service in the same region as Supabase (us-east-1 above): every
# query still takes three network round trips.
# NFNIT_DB_POOL_MAX=10
# Verifies Supabase access tokens via the project's JWKS (ES256).
SUPABASE_URL=https://PROJECT.supabase.co
# Never set NFNIT_ALLOW_LOCAL_AUTH_BYPASS in production: it makes every
# signed-in user share one project list.
# Signs the short-lived links the browser uses to download meshes directly
# from this service. Generate once: python -c "import secrets;print(secrets.token_hex(32))"
# A distinct random value for this environment, at least 32 bytes.
NFNIT_MESH_URL_SECRET=

# Optional run limits (defaults shown)
# Models a run may use (comma-separated), and per-user limits on runs and
# sandbox calls. They protect the OpenRouter and server bill from one account.
# CAD_ALLOWED_MODELS=anthropic/claude-sonnet-5.5,anthropic/claude-opus-5.5
# CAD_MAX_CONCURRENT_RUNS=2
# CAD_MAX_RUNS_PER_HOUR=30
# CAD_MAX_RUNS_PER_DAY=150
# CAD_SANDBOX_CALLS_PER_MINUTE=60
# CAD_SANDBOX_MAX_CONCURRENT_PER_USER=2
# CAD_SANDBOX_LEASE_SECONDS=240
# CAD_MAX_EVENT_STREAMS_PER_USER=4
# Persisted project history, meshes, thumbnails, runs and events per account.
# CAD_MAX_STORAGE_BYTES_PER_USER=134217728
# CAD_MAX_PROJECTS_PER_USER=100
# CAD_MAX_REVISIONS_PER_USER=1000
# CAD_RUN_TIMEOUT_SECONDS=300
# CAD_LLM_TIMEOUT_SECONDS=120
# CAD_SANDBOX_CPU_SECONDS=45
# CAD_SANDBOX_MEMORY_BYTES=2147483648
# CAD_SANDBOX_FILE_BYTES=268435456
# CAD_SANDBOX_MAX_PROCESSES=256
# CAD_SANDBOX_UID_BASE=100000
# CAD_SANDBOX_GID_BASE=100000
# CAD_MAX_REQUEST_BYTES=20971520

# Optional
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key
# LANGFUSE_SECRET_KEY=sk-lf-your-key
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=production
# PINECONE_API_KEY=pcsk-your-key
# PINECONE_INDEX_HOST=your-index-host.pinecone.io
# PINECONE_INDEX_NAME=nfinit-build123d
# PINECONE_NAMESPACE=build123d-patterns-v1
