# Vercel = Next.js studio only. Do not add a FastAPI service.
#
# Create-project screen:
#   1. Import MoayyadShahid/Nfinit
#   2. If Vercel shows a "Services" canvas with frontend + backend,
#      delete the FastAPI / backend card. CAD cannot run on Vercel.
#   3. Keep only frontend (Next.js)
#   4. Project name: nfinit
#   5. Root Directory: leave empty if using the repo vercel.json
#      (services.frontend.root = frontend). Or set Root Directory to
#      frontend and ignore the Services preset.
#   6. Build / Install / Output: None (auto)
#   7. Add the vars below, then Deploy
#
# After Railway gives you a public URL, come back and set both backend URLs.

BACKEND_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
